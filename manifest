appname               = fn_qycs
version               = 1.0.0
display_name          = 千盈传送
desc                  = 临时急救传文件专用，浏览器打开就能用，无需安装任何客户端<br><br>场景：同事急着要个大文件，U 盘找不到，微信又传不了<br>直接浏览器打开链接就能传，对方也不用装 APP，省去一切折腾<br><br>WebRTC P2P 直传，文件不走服务器中转，内网速度拉满<br>图片和视频能直接保存到手机相册（需配合公网访问配置）<br>跨平台支持，iOS、Android、Windows、Mac 都能用<br><br>自带反向代理，配上飞牛 DDNS 域名就能从外网访问<br>证书直接用飞牛 NAS 里签发的，不用另外折腾<br><br>主题跟随飞牛系统自动切换，暗色亮色都好看<br>x86 和 ARM 都支持
platform              = all
source                = thirdparty
service_port          = 5553
checkport             = true
ctl_stop              = yes
gateway_socket        = app.sock
