#!/bin/bash
# 千盈传送 - 生命周期管理脚本
# 反向代理已内嵌到主程序中，无需单独管理 rproxy 二进制

VAR_DIR="${TRIM_PKGVAR}"
PID_FILE="${VAR_DIR}/app.pid"
APP_DIR="${TRIM_APPDEST}/server"

if [ -n "$TRIM_DATA_SHARE_PATHS" ]; then
    _SHARE_BASE="${TRIM_DATA_SHARE_PATHS%%:*}"
    SHARE_LOG_DIR="${_SHARE_BASE}/logs"
else
    SHARE_LOG_DIR=""
fi

if [ -n "$SHARE_LOG_DIR" ]; then
    LOG_DIR="$SHARE_LOG_DIR"
elif [ -n "$TRIM_PKGVAR" ]; then
    LOG_DIR="${TRIM_PKGVAR}/logs"
else
    LOG_DIR="/tmp/fn_qycs/logs"
fi

if [ -n "$TRIM_PKGVAR" ]; then
    DATA_DIR="${TRIM_PKGVAR}/data"
elif [ -n "$TRIM_APPDEST" ]; then
    DATA_DIR="${TRIM_APPDEST}/data"
else
    DATA_DIR="/tmp/fn_qycs/data"
    log "[WARN] 数据目录使用 /tmp，NAS 重启后反代配置将丢失！"
fi

export DATA_DIR
mkdir -p "$DATA_DIR" "$LOG_DIR" 2>/dev/null || true

INSTALL_CONF="${DATA_DIR}/install.conf"
[ -f "$INSTALL_CONF" ] && source "$INSTALL_CONF"

if [ -n "$WIZARD_APP_PORT" ]; then
    APP_PORT="$WIZARD_APP_PORT"
elif [ -n "$wizard_app_port" ]; then
    APP_PORT="$wizard_app_port"
else
    APP_PORT="5553"
fi
export PORT="${APP_PORT}"

APP_LOG="${LOG_DIR}/app.log"
DEBUG_LOG="${LOG_DIR}/debug.log"
mkdir -p "$(dirname "$APP_LOG")" 2>/dev/null || true

ARCH=$(uname -m)
case "$ARCH" in
    x86_64) BIN_NAME="fn_qycs-server-amd64" ;;
    aarch64) BIN_NAME="fn_qycs-server-arm64" ;;
    *) BIN_NAME="fn_qycs-server-amd64" ;;
esac
SERVER_BIN="${APP_DIR}/${BIN_NAME}"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$APP_LOG"; }
fatal() { log "FATAL: $*"; [ -n "$TRIM_TEMP_LOGFILE" ] && echo "FATAL: $*" >> "$TRIM_TEMP_LOGFILE"; exit 1; }

start() {
    log "=== START ==="
    [ -f "$PID_FILE" ] && { OLD=$(cat "$PID_FILE"); kill -0 "$OLD" 2>/dev/null && { log "进程已在运行 (PID=$OLD)"; exit 0; }; rm -f "$PID_FILE"; }

    # 清理残留 socket
    rm -f "/var/apps/fn_qycs/target/app.sock" 2>/dev/null || true
    [ -n "$TRIM_APPDEST" ] && rm -f "${TRIM_APPDEST}/target/app.sock" 2>/dev/null || true

    log "[1/4] 检测二进制文件..."
    [ ! -x "$SERVER_BIN" ] && chmod +x "$SERVER_BIN" 2>/dev/null
    [ ! -x "$SERVER_BIN" ] && fatal "二进制文件不存在: $SERVER_BIN"
    log "  架构: $ARCH, 二进制: $BIN_NAME"

    log "[2/4] 配置数据目录..."
    log "  数据目录: $DATA_DIR"

    log "[3/4] 配置统一网关..."
    GATEWAY_PREFIX="/app/fn_qycs"
    export GATEWAY_PREFIX="$GATEWAY_PREFIX"
    GATEWAY_SOCK_PATH="/var/apps/fn_qycs/target/app.sock"
    if [ -n "$UNIX_SOCKET" ] && [ "${UNIX_SOCKET:0:1}" = "/" ]; then
        GATEWAY_SOCK_PATH="$UNIX_SOCKET"
    elif [ -n "$UNIX_SOCKET" ]; then
        GATEWAY_SOCK_PATH="/var/apps/fn_qycs/target/${UNIX_SOCKET}"
    fi
    SOCK_DIR=$(dirname "$GATEWAY_SOCK_PATH")
    mkdir -p "$SOCK_DIR" 2>/dev/null
    [ ! -d "$SOCK_DIR" ] && [ -n "$TRIM_APPDEST" ] && {
        GATEWAY_SOCK_PATH="${TRIM_APPDEST}/target/app.sock"
        mkdir -p "${TRIM_APPDEST}/target" 2>/dev/null
    }
    export GATEWAY_SOCKET="$GATEWAY_SOCK_PATH"
    EXTRA_SOCK="/var/apps/fn_qycs/target/app.sock"
    if [ "$GATEWAY_SOCK_PATH" != "$EXTRA_SOCK" ]; then
        export EXTRA_SOCKET_PATH="$EXTRA_SOCK"
        mkdir -p "$(dirname "$EXTRA_SOCK")" 2>/dev/null
    elif [ -n "$TRIM_APPDEST" ]; then
        export EXTRA_SOCKET_PATH="${TRIM_APPDEST}/target/app.sock"
        mkdir -p "${TRIM_APPDEST}/target" 2>/dev/null
    fi
    log "  网关: ${GATEWAY_PREFIX} → ${GATEWAY_SOCK_PATH}"

    log "[4/4] 启动服务..."
    log "  监听端口: ${APP_PORT}"
    cd "$APP_DIR" || fatal "无法进入应用目录: $APP_DIR"
    nohup "$SERVER_BIN" >> "$DEBUG_LOG" 2>&1 &
    SERVER_PID=$!
    echo "$SERVER_PID" > "$PID_FILE"
    sleep 1
    kill -0 "$SERVER_PID" 2>/dev/null || { rm -f "$PID_FILE"; tail -20 "$DEBUG_LOG" | tee -a "$APP_LOG"; fatal "进程启动失败!"; }
    sleep 2
    if kill -0 "$SERVER_PID" 2>/dev/null; then
        log "  PID=$SERVER_PID"
        log "=== 启动成功! 端口 ${APP_PORT} (反代已内嵌) ==="
        exit 0
    else
        rm -f "$PID_FILE"
        fatal "进程 3s 内退出!"
    fi
}

stop() {
    log "=== STOP ==="

    log "[1/3] 发送终止信号..."
    # 反代内嵌在主进程中，杀死主进程即可
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            log "  向 PID=$PID 发送 SIGTERM..."
            kill "$PID" 2>/dev/null

            # 等待进程自行清理（包括反代停止）
            for i in $(seq 1 10); do
                kill -0 "$PID" 2>/dev/null || { log "  进程已优雅退出 (${i}s)"; break; }
                sleep 1
            done

            # 如果还没退出，强制杀死
            if kill -0 "$PID" 2>/dev/null; then
                log "  进程未响应，强制终止"
                kill -9 "$PID" 2>/dev/null
                sleep 1
            fi

            # 检查是否有残留的反代端口监听
            RPROXY_PID=$(ss -tlnp 2>/dev/null | grep -E ':7753|:1443' | awk '{print $NF}' | grep -oP 'pid=\K\d+' | head -1)
            if [ -n "$RPROXY_PID" ]; then
                log "  清理残留反代进程 PID=$RPROXY_PID"
                kill -9 "$RPROXY_PID" 2>/dev/null || true
            fi
        else
            log "  进程不存在"
        fi
        rm -f "$PID_FILE"
    else
        log "  没有运行中的进程"
    fi

    log "[2/3] 清理 socket 文件..."
    rm -f "/var/apps/fn_qycs/target/app.sock" 2>/dev/null || true
    [ -n "$TRIM_APPDEST" ] && rm -f "${TRIM_APPDEST}/target/app.sock" 2>/dev/null || true
    [ -n "$GATEWAY_SOCK_PATH" ] && rm -f "$GATEWAY_SOCK_PATH" 2>/dev/null || true

    log "[3/3] 停止完成"
    log "=== 日志文件: ${LOG_DIR}/ ==="
    exit 0
}

status() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        exit 0
    fi
    check_port="${APP_PORT:-5553}"
    ss -tlnp 2>/dev/null | grep -q ":${check_port}" && exit 0
    exit 3
}

uninstall() {
    log "=== UNINSTALL ==="
    log "[1/2] 停止所有服务..."
    stop
    log "[2/2] 清理配置..."
    # 保留日志以便排查问题，只清理运行时数据
    [ -n "$DATA_DIR" ] && rm -f "${DATA_DIR}/rproxy-config.json" 2>/dev/null || true
    log "卸载完成（日志保留在 ${LOG_DIR}/）"
    exit 0
}
upgrade() { log "=== UPGRADE ==="; stop; start; }

case "$1" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    uninstall) uninstall ;;
    upgrade) upgrade ;;
    *) echo "用法: $0 {start|stop|status|uninstall|upgrade}"; exit 1 ;;
esac
